{
  "server": {
    "listen_port": 9090,
    "backend_host": "127.0.0.1",
    "backend_port": 8080
  },
  "rate_limits": [
    {
      "path": "/login",
      "method": "POST",
      "limit": 5,
      "window_seconds": 60
    },
    {
      "path": "/balance",
      "method": "GET",
      "limit": 100,
      "window_seconds": 60
    }
  ],
  "security": {
    "block_sql_injection": true,
    "blacklisted_ips": ["192.168.1.10", "10.0.0.5"]
  },
  "jwt": {
    "protected_routes": ["/balance", "/transfer"],
    "secret": "super_secret_key"
  }
}
